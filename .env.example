# NO KEY NEEDED. With this file missing or empty, the app runs fully offline with its built-in coach.
# Only add ONE of the options below if you want the optional AI coach.

# Option 1: Google Gemini
# GEMINI_API_KEY=your-key

# Option 2: Anthropic Claude
# ANTHROPIC_API_KEY=your-key

# Option 3: Any OpenAI-compatible service (OpenAI, OpenRouter, Groq, LM Studio...)
# OPENAI_API_KEY=your-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 4: Free local model with Ollama (no key, nothing leaves your computer)
# LLM_PROVIDER=ollama
# COACH_MODEL=llama3.2

# Optional: force a provider (gemini, anthropic, openai, ollama, none) and/or pick a model
# LLM_PROVIDER=none
# COACH_MODEL=
